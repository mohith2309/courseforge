PORT=8788

# AI
GEMINI_API_KEY=your_gemini_key_from_ai.google.dev
GEMINI_MODEL=gemini-2.5-flash
NVIDIA_API_KEY=your_nvidia_nim_key
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# Payments
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Auth + admin (set a long random ADMIN_TOKEN in production)
JWT_SECRET=set_a_long_random_string
ADMIN_TOKEN=set_a_long_random_admin_token

# Datastore (all zero-dependency):
#   file      -> ./data/*.json (default, good for dev)
#   firestore -> Cloud Firestore via REST, authed as a service user. Data lives
#                under users/{serviceUid}/cf_store/{collection} so it works with
#                rules that grant a user access to their own subtree.
#   firebase  -> Firebase Realtime Database via REST
DATA_BACKEND=file
# --- firestore ---
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_API_KEY=your_web_api_key
# FIREBASE_BACKEND_EMAIL=courseforge-backend@cf.local
# FIREBASE_BACKEND_PASSWORD=a_long_random_password
# --- firebase rtdb ---
# FIREBASE_DB_URL=https://your-project-default-rtdb.firebaseio.com
# FIREBASE_DB_SECRET=rtdb_secret_or_token   # optional if rules are open
